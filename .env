# ==========================================
# Lagos Rent Platform — Environment Template
# ==========================================

# PostgreSQL Infrastructure
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SUPER_USER=postgres
POSTGRES_SUPER_PASSWORD=supersecret_postgres_password

# Database Passwords (Database per service)
ACCOUNT_DB_PASSWORD=account_db_pass
LISTING_DB_PASSWORD=listing_db_pass
RENTAL_DB_PASSWORD=rental_db_pass
PAYMENT_DB_PASSWORD=payment_db_pass
SEARCH_DB_PASSWORD=search_db_pass
NOTIFICATION_DB_PASSWORD=notification_db_pass

# RabbitMQ Message Broker
RABBITMQ_DEFAULT_USER=lagos_user
RABBITMQ_DEFAULT_PASS=lagos_rabbit_password

# Keycloak Identity Provider
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secret_pass

# AWS S3 Object Storage Configuration
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_PUBLIC_MEDIA_BUCKET=lagos-rent-listing-media
AWS_S3_PRIVATE_DOCS_BUCKET=lagos-rent-verification-docs


