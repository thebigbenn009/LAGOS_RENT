{
  "info": {
    "_postman_id": "a901f4c2-98ab-41c0-a7d1-lagos-rent-api",
    "name": "Lagos Rent Platform API",
    "description": "Postman Collection for Lagos Rent distributed services (Account, Listing, Search, Rental, Payment, Keycloak Auth).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Authentication (Keycloak)",
      "item": [
        {
          "name": "Landlord Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.environment.set('landlord_token', json.access_token);",
                  "    console.log('✅ Landlord token saved to environment variable landlord_token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "client_id", "value": "web-application", "type": "text" },
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "username", "value": "landlord_test", "type": "text" },
                { "key": "password", "value": "Password123!", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{keycloak_url}}/realms/lagos-rent/protocol/openid-connect/token",
              "host": ["{{keycloak_url}}"],
              "path": ["realms", "lagos-rent", "protocol", "openid-connect", "token"]
            }
          }
        },
